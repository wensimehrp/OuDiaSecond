        MENUITEM "印刷ページ設定(&P)...",              ID_FILE_PrintPageProp
        MENUITEM "プリンタの設定(&R)...",              ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近使ったファイル",                   ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "路線ファイルのプロパティ(&I)...",         ID_ROSEN_FILE_PROP
        MENUITEM "ダイヤ一覧(&D)...",                ID_ROSEN_DIALIST
        MENUITEM SEPARATOR
        MENUITEM "アプリケーションの終了(&X)",             ID_APP_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "元に戻す(&U)\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM "やり直し(&R)\tCtrl+Y",            ID_EDIT_REDO
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "ツール バー(&T)",                  ID_VIEW_TOOLBAR
        MENUITEM "ステータス バー(&S)",                ID_VIEW_STATUS_BAR
    END
    POPUP "移動(&M)"
    BEGIN
        MENUITEM "時刻表に移動(&J)\tEnter",           ID_CrossingCheck_MoveToJikokuhyou
    END
    POPUP "ウィンドウ(&W)"
    BEGIN
        MENUITEM "ペインの切替(&P)",                  ID_WINDOW_ROSEN_VIEW
        MENUITEM SEPARATOR
        MENUITEM "新しいウィンドウを開く(&N)",             ID_WINDOW_NEW
        MENUITEM "重ねて表示(&C)",                   ID_WINDOW_CASCADE
        MENUITEM "上下に並べて表示(&T)",                ID_WINDOW_TILE_HORZ
        MENUITEM "左右に並べて表示(&V)",                ID_WINDOW_TILE_VERT
        MENUITEM "アイコンの整列(&A)",                 ID_WINDOW_ARRANGE
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "目次...\tF1",                   ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "OuDiaSecond  のバージョン情報(&A)...", ID_APP_ABOUT
    END
END

