IDR_MAINFRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規作成(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM "開く(&O)...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "上書き保存(&S)\tCtrl+S",           ID_FILE_SAVE
        MENUITEM "名前を付けて保存(&A)...",             ID_FILE_SAVE_AS
        MENUITEM "自動バックアップを有効にする(&B)",          ID_FILE_BACKUP
        MENUITEM "ウインドウ位置を復元する(&W)",            ID_FILE_WindowPlacementRestore
        MENUITEM "外部時刻表インポート(&M)",              ID_FILE_DIGITAL_JIKOKUHYOU_IMPORT
        MENUITEM SEPARATOR
        MENUITEM "印刷ページ設定(&P)...",              ID_FILE_PrintPageProp
        MENUITEM "プリンタの設定(&R)...",              ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近使ったファイル",                   ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "路線ファイルのプロパティ(&I)...",         ID_ROSEN_FILE_PROP
        MENUITEM "ダイヤ一覧(&D)...",                ID_ROSEN_DIALIST
        MENUITEM SEPARATOR
        MENUITEM "アプリケーションの終了(&X)",             ID_APP_EXIT
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "ステータス バー(&S)",                ID_VIEW_STATUS_BAR
        MENUITEM "ツール バー(&T)",                  ID_VIEW_TOOLBAR
    END
    POPUP "ウィンドウ(&W)"
    BEGIN
        MENUITEM "ペインの切替(&P)",                  ID_WINDOW_ROSEN_VIEW
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "目次...\tF1",                   ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "OuDiaSecond  のバージョン情報(&A)...", ID_APP_ABOUT
    END
END

